#!/usr/bin/env bash
# publish — the only writer to the source-of-truth branch (docs/CORE_OPERATING_POLICY.md §5).
#
# usage:
#   scripts/publish <handoff-id> --actor <actor> [flags]      commit + push the working-tree changes for one handoff
#   scripts/publish --event governance|recovery --actor <actor> --message "…" [--dry-run]
#   scripts/publish --regen [--no-fetch]                       regenerate state + indexes in the working tree only
#   scripts/publish --drift [--no-fetch]                       list commits on the source-of-truth branch without receipts
#
# flags (handoff mode):
#   --dry-run                 classify and validate; change nothing
#   --no-fetch                skip git fetch (offline testing)
#   --dispatch                ready -> dispatched (runs handoff-check; freezes body; stamps manifest/instructions hashes;
#                             --model required for judgment/divergence lanes)
#   --model <id>              record model in the header (with --dispatch)
#   --set-status <s>          landed -> accepted|returned ; any open -> blocked (needs --reason) ; any -> superseded
#   --reason "<text>"         reason for blocked / --allow-large / --content-modified substantive
#   --message "<text>"        commit summary
#   --generated-by <actor>    airlock/branch landing: who produced the content (differs from --actor)
#   --source "<desc>"         airlock/branch landing: where it came from (paste, serve URL, export, branch@sha)
#   --content-modified none|formatting-only|substantive   (default none; verified against <output>.airlock.txt)
#   --allow-large             override size limits (needs --reason)
#   --manifest <path>         project manifest (default $MANIFEST or PROJECT_MANIFEST.yaml)
#
# Generalized (Increment 1b): actors, roles, source-of-truth branch, output
# layout, protected paths, approval gates and limits are resolved from the
# PROJECT MANIFEST + config registries. Unproven until the Increment 2 fixtures
# pass (docs/BUILD_STATUS.md).
set -eo pipefail
cd "$(git rev-parse --show-toplevel)"
. scripts/lib/core.sh

ID=""; ACTOR=""; DRY=0; EVENT=""; MSG=""; DISPATCH=0; MODEL=""; SETSTATUS=""; REASON=""
GENBY=""; SOURCE=""; CMOD="none"; ALLOWLARGE=0; MODE=handoff; MANIFEST_ARG=""
while [ $# -gt 0 ]; do
  case $1 in
    --regen) MODE=regen;; --drift) MODE=drift;; --micro) MODE=micro;;
    --actor) ACTOR=$2; shift;; --dry-run) DRY=1;; --no-fetch) NO_FETCH=1;;
    --event) EVENT=$2; shift;; --message) MSG=$2; shift;; --dispatch) DISPATCH=1;;
    --model) MODEL=$2; shift;; --set-status) SETSTATUS=$2; shift;; --reason) REASON=$2; shift;;
    --generated-by) GENBY=$2; shift;; --source) SOURCE=$2; shift;; --content-modified) CMOD=$2; shift;;
    --allow-large) ALLOWLARGE=1;; --manifest) MANIFEST_ARG=$2; shift;;
    -*) die "unknown flag $1";;
    *) [ -z "$ID" ] && ID=$1 || die "unexpected argument $1";;
  esac; shift
done

resolve_manifest "$MANIFEST_ARG"

# ---------------------------------------------------------------- generators
# STATE_REF: the ref outputs are checked against. origin/<sot> normally; HEAD during the records step.
STATE_REF=${STATE_REF:-origin/$SOT_BRANCH}
ref_has() { git cat-file -e "$STATE_REF:$1" 2>/dev/null; }

regen_index() {  # slug
  local slug=$1 f="$PROJECTS_ROOT/$1/handoff/README.md" p id role st lane tier actor outs sha
  { echo "# Handoffs — $slug"; echo; echo "Generated by \`scripts/publish\` — do not edit. Status authority: \`docs/CORE_OPERATING_POLICY.md\` §4."; echo
    echo "| Handoff | Role | Status | Lane | Tier | Actor | Outputs (@ commit that landed them) | Supersedes |"; echo "|---|---|---|---|---|---|---|---|"
    for p in $(ls "$PROJECTS_ROOT/$slug/handoff/"[0-9][0-9][0-9]-*.md 2>/dev/null | sort); do
      hdr_present "$p" || continue
      id=$(hdr_get "$p" handoff); role=$(hdr_get "$p" role); st=$(hdr_get "$p" status); lane=$(hdr_get "$p" lane); tier=$(hdr_get "$p" tier); actor=$(hdr_get "$p" actor)
      outs=""; while IFS= read -r o; do [ -z "$o" ] && continue
        if ref_has "$o"; then sha=$(git log -1 --format=%h "$STATE_REF" -- "$o" 2>/dev/null || true); outs="$outs\`${o#"$PROJECTS_ROOT/$slug/"}\` @ $sha<br>"
        else outs="$outs\`${o#"$PROJECTS_ROOT/$slug/"}\` (not on $SOT_BRANCH)<br>"; fi; done < <(hdr_list "$p" outputs)
      echo "| [$id]($(basename "$p")) | $role | **$st** | $lane | $tier | $actor | ${outs%<br>} | $(hdr_get "$p" supersedes) |"
    done; } > "$f"
}

regen_state() {
  local f="docs/STATE.md" slug p id role st lane actor now
  now=$(date -u +%Y-%m-%dT%H:%MZ)
  { echo "# STATE"; echo
    echo "Generated by \`scripts/publish\` at $now — do not edit. Project: $PROJECT. Core: $POLICY_VERSION."
    echo "State through workflow commit: \`$(git rev-parse --short=7 "$STATE_REF")\` ($(git log -1 --format=%cs "$STATE_REF")) on \`$SOT_BRANCH\`. The records commit that carries this file follows it."; echo
    echo "A session reads the manifest, this file, the charter, and the packet named in its dispatch (§11). No \`HANDOFF:\` line in the dispatch = orientation only."; echo
    for slug in $(ls "$PROJECTS_ROOT/" 2>/dev/null); do
      [ -d "$PROJECTS_ROOT/$slug/handoff" ] || continue
      echo "## $slug"; echo
      echo "| Handoff | Role | Status | Lane | Actor | Next action |"; echo "|---|---|---|---|---|---|"
      local any=0
      for p in $(ls "$PROJECTS_ROOT/$slug/handoff/"[0-9][0-9][0-9]-*.md 2>/dev/null | sort); do
        hdr_present "$p" || continue; st=$(hdr_get "$p" status); id=$(hdr_get "$p" handoff)
        in_list "$st" accepted superseded && continue
        in_list "$st" returned blocked && grep -lqs "^supersedes: $id\$" "$PROJECTS_ROOT/$slug/handoff/"[0-9][0-9][0-9]-*.md && continue
        any=1; role=$(hdr_get "$p" role); lane=$(hdr_get "$p" lane); actor=$(hdr_get "$p" actor)
        echo "| $id | $role | **$st** | $lane | $actor | $(next_action_for "$st" "$actor" "$role") |"
      done
      [ $any = 1 ] || echo "| — | — | — | — | — | no open handoffs: orchestrator writes the next one |"
      echo; echo "Last accepted: $(for p in $(ls "$PROJECTS_ROOT/$slug/handoff/"[0-9][0-9][0-9]-*.md 2>/dev/null | sort -r); do hdr_present "$p" && [ "$(hdr_get "$p" status)" = accepted ] && { hdr_get "$p" handoff; break; }; done || echo none). Full index: \`$PROJECTS_ROOT/$slug/handoff/README.md\`."; echo
    done
    echo "## Pending ${OWNER:-owner} decisions"; echo
    local dec; dec=$(grep -B6 '^\*\*Status:\*\* Proposed' docs/activity_log/DECISIONS_LOG.md 2>/dev/null | grep -oE '^## DECISION-[0-9]+ — .*' | grep -v 'DECISION-0000' || true)
    if [ -n "$dec" ]; then printf '%s\n' "$dec" | sed 's/^## /- /'; else echo "- none recorded as Proposed in DECISIONS_LOG.md"; fi; echo
    echo "## Branches (remote, unmerged into $SOT_BRANCH)"; echo
    local ref ts age ahead flag any=0
    while read -r ref ts; do
      case $ref in origin/$SOT_BRANCH|origin/HEAD|origin) continue;; esac
      git merge-base --is-ancestor "$ref" "origin/$SOT_BRANCH" 2>/dev/null && continue
      any=1; ahead=$(git rev-list --count "origin/$SOT_BRANCH".."$ref"); age=$(( $(date +%s) - ts ))
      flag=""; [ $age -gt $STALE_SECONDS ] && flag=" **STALE** (>$((STALE_SECONDS/3600))h)"
      echo "- \`${ref#origin/}\` — $ahead commit(s) ahead, last push $(epoch_to_date "$ts")$flag"
    done < <(git for-each-ref refs/remotes/origin --format='%(refname:short) %(committerdate:unix)')
    [ $any = 1 ] || echo "- none"
    echo; echo "Open PRs are not derivable offline — check the host. Every branch must end merged-and-deleted, superseded-and-deleted, or blocked (§6/§10)."; echo
    echo "## Drift"; echo; echo "Run \`scripts/publish --drift\` to list commits on $SOT_BRANCH without workflow trailers."
  } > "$f"
}

log_append() {  # event id actor sha "paths" "status-line" "next"
  local f="docs/activity_log/ACTIVITY_LOG.md"
  { echo; echo "## $(date -u +%Y-%m-%dT%H:%MZ) — $1 — ${2:-kit} — $3"
    echo "- Landed @ $4: $5"; [ -n "$6" ] && echo "- Status: $6"; [ -n "$7" ] && echo "- Next: $7"
    [ -n "$MSG" ] && echo "- Note: $MSG"; :; } >> "$f"
}

regen_all() { local s; for s in $(ls "$PROJECTS_ROOT/" 2>/dev/null); do [ -d "$PROJECTS_ROOT/$s/handoff" ] && regen_index "$s"; done; regen_state; }

# ---------------------------------------------------------------- regen / drift modes
if [ $MODE = regen ]; then fetch_sot; regen_all; echo "regenerated docs/STATE.md and handoff indexes (working tree only)"; exit 0; fi
if [ $MODE = drift ]; then
  fetch_sot
  from=$(git log --format=%H --diff-filter=A "origin/$SOT_BRANCH" -- docs/CORE_OPERATING_POLICY.md | tail -1)
  [ -n "$from" ] || die "no CORE_OPERATING_POLICY.md on $SOT_BRANCH to anchor drift"
  n=0
  while read -r h; do
    body=$(git log -1 --format=%B "$h"); subj=$(git log -1 --format=%s "$h")
    if printf '%s' "$body" | grep -qE '^Workflow-Event: (handoff-created|status-changed|output-landed|governance|recovery|records|micro)$'; then continue; fi
    case "$subj" in "Merge pull request #"*) continue;; esac
    n=$((n+1)); echo "DRIFT $h $(git log -1 --format='%cs %an' "$h") | $subj"
  done < <(git rev-list "$from".."origin/$SOT_BRANCH")
  [ $n = 0 ] && echo "no drift since $from" || { echo "$n commit(s) on $SOT_BRANCH without a workflow receipt"; exit 1; }; exit 0
fi

# ---------------------------------------------------------------- micro mode (§12)
# Reversible, low-blast-radius change: no packet, a compact append-only event.
# usage: scripts/publish --micro --actor <a> --message "<result>" [--reason "<scope/evidence>"]
if [ $MODE = micro ]; then
  [ -n "$ACTOR" ] || die "--actor required"; in_list "$ACTOR" $ACTORS || die "actor '$ACTOR' not in: $ACTORS"
  [ "$(actor_authority "$ACTOR")" = none ] && die "actor '$ACTOR' has authority: none (evidence only, §2); it cannot write source-of-truth"
  [ -n "$MSG" ] || die "--message required for micro (the result, §12)"
  fetch_sot
  [ "$(git rev-parse --abbrev-ref HEAD)" = "$SOT_BRANCH" ] || die "micro runs on $SOT_BRANCH (you are on $(git rev-parse --abbrev-ref HEAD))"
  [ "$(git rev-parse HEAD)" = "$(git rev-parse "origin/$SOT_BRANCH")" ] || die "local $SOT_BRANCH != origin/$SOT_BRANCH; run: git pull --ff-only origin $SOT_BRANCH"
  declare -a MC=(); while IFS= read -r line; do [ -z "$line" ] && continue; p=${line:3}; p=${p##* -> }; MC+=("$p"); done < <(git status --porcelain --untracked-files=all)
  [ ${#MC[@]} -gt 0 ] || die "micro: nothing to publish"
  for c in "${MC[@]}"; do is_protected_path "$c" && die "micro cannot touch protected path $c — use --event governance (§6)"; done
  echo "micro-change  actor=$ACTOR  project=$PROJECT  paths=${#MC[@]}"
  if [ $DRY = 1 ]; then echo "DRY-RUN: would record a micro event for: ${MC[*]}"; exit 0; fi
  f=docs/activity_log/ACTIVITY_LOG.md
  { echo; echo "## $(date -u +%Y-%m-%dT%H:%MZ) — micro-change — $PROJECT — $ACTOR"
    echo "- Scope: ${REASON:-$MSG}"; echo "- Paths: $(printf '%s; ' "${MC[@]}" | sed 's/; $//')"; echo "- Result: $MSG"; } >> "$f"
  git add -A -- "${MC[@]}" "$f"
  git commit -q -m "$(printf 'micro-change: %s\n\nWorkflow-Event: micro\nActor: %s\nProject: %s\nCore-Version: %s\n' "$MSG" "$ACTOR" "$PROJECT" "$POLICY_VERSION")"
  if ! git push -q origin "$SOT_BRANCH" 2>/dev/null; then
    RESCUE="rescue/micro-$(date -u +%Y%m%d-%H%M%S)"; git branch -q "$RESCUE" HEAD; git fetch -q origin "$SOT_BRANCH"; git reset -q --hard "origin/$SOT_BRANCH"
    die "push to $SOT_BRANCH rejected; micro commit preserved on $RESCUE; local realigned. Do NOT force-push."
  fi
  git fetch -q origin "$SOT_BRANCH"
  echo "---"; echo "micro recorded @ $(sot_sha) on $SOT_BRANCH"; exit 0
fi

# ---------------------------------------------------------------- handoff / governance mode
[ -n "$ACTOR" ] || die "--actor required"; in_list "$ACTOR" $ACTORS || die "actor '$ACTOR' not in: $ACTORS"
# authority (§2): an authority:none actor produces evidence only — it cannot set lifecycle state
if [ $DISPATCH = 1 ] || in_list "$SETSTATUS" accepted returned; then
  [ "$(actor_authority "$ACTOR")" = none ] && die "actor '$ACTOR' has authority: none (evidence only, §2); it cannot dispatch or accept/return"
fi
[ -z "$EVENT" ] || in_list "$EVENT" governance recovery || die "--event must be governance or recovery"
[ -n "$ID" ] || [ -n "$EVENT" ] || die "handoff id required (or --event governance|recovery)"
fetch_sot
[ "$(git rev-parse --abbrev-ref HEAD)" = "$SOT_BRANCH" ] || die "publish runs on $SOT_BRANCH (you are on $(git rev-parse --abbrev-ref HEAD)); the steward must have a $SOT_BRANCH checkout with push rights"
[ "$(git rev-parse HEAD)" = "$(git rev-parse "origin/$SOT_BRANCH")" ] || die "local $SOT_BRANCH != origin/$SOT_BRANCH; run: git pull --ff-only origin $SOT_BRANCH"

PKT=""; STATUS=""; SLUG=""; NNN=""; FROLE=""; PACTOR=""; PLANE=""; PTIER=""; PSURF=""; declare -a OUTPUTS=()
if [ -n "$ID" ]; then
  PKT=$(packet_from_id "$ID") || die "no single packet for id $ID"
  path_parts "$PKT" || die "bad packet path $PKT"
  STATUS=$(hdr_get "$PKT" status); PACTOR=$(hdr_get "$PKT" actor); PLANE=$(hdr_get "$PKT" lane)
  PTIER=$(hdr_get "$PKT" tier); PSURF=$(hdr_get "$PKT" surface); read_into OUTPUTS hdr_list "$PKT" outputs
fi
GEN_FILES=(docs/STATE.md docs/activity_log/ACTIVITY_LOG.md); for s in $(ls "$PROJECTS_ROOT/" 2>/dev/null); do [ -d "$PROJECTS_ROOT/$s/handoff" ] && GEN_FILES+=("$PROJECTS_ROOT/$s/handoff/README.md"); done

# working-tree change set (renames -> new path); deletions tracked separately
declare -a CHANGED=() DELETED=()
while IFS= read -r line; do
  [ -z "$line" ] && continue; code=${line:0:2}; p=${line:3}; p=${p##* -> }
  CHANGED+=("$p"); case "$code" in *D*) DELETED+=("$p");; esac
done < <(git status --porcelain --untracked-files=all)
is_gen() { in_list "$1" "${GEN_FILES[@]}"; }
declare -a WORK=(); for c in "${CHANGED[@]}"; do is_gen "$c" || WORK+=("$c"); done

echo "publish ${ID:-$EVENT}  actor=$ACTOR  project=$PROJECT  core=$POLICY_VERSION  sot=$SOT_BRANCH$( [ $DRY = 1 ] && echo '  DRY-RUN')"
echo "changed files (excluding generated): ${#WORK[@]}"; for c in "${WORK[@]}"; do echo "  - $c$(in_list "$c" "${DELETED[@]}" && echo ' (deleted)')"; done

# approval-gate check (§8): each gate-id listed for a transition needs a recorded approval
check_gate() {  # required_approvals.<field>
  local field=$1 g inline; inline=$(yget "$MANIFEST" "required_approvals.$field")
  for g in $(parse_inline_list "$inline"); do
    has_approval "$ID" "$g" || die "$field gate '$g' requires a recorded approval for $ID in docs/activity_log/APPROVALS_LOG.md (§8)"
    echo "gate ok: $field/$g approved for $ID"
  done
}

# --- classify event
NEWSTATUS=""; SUMMARY=""; declare -a LANDED=()
if [ -n "$EVENT" ]; then
  [ ${#WORK[@]} -gt 0 ] || [ ${#CHANGED[@]} -gt 0 ] || die "nothing to publish"
  [ -n "$MSG" ] || die "--message required for $EVENT"; SUMMARY=$MSG
elif [ $DISPATCH = 1 ]; then
  EVENT=status-changed; [ "$STATUS" = ready ] || die "dispatch requires status ready (is $STATUS); run handoff-check first"
  for c in "${WORK[@]}"; do [ "$c" = "$PKT" ] || die "dispatch commits only the packet; unexpected change: $c"; done
  m=${MODEL:-$(hdr_get "$PKT" model)}
  if in_list "$PLANE" judgment divergence && { [ -z "$m" ] || [ "$m" = unspecified ]; }; then die "lane $PLANE requires a model: re-run with --model <id> (§2)"; fi
  echo "handoff-check before dispatch:"; scripts/handoff-check "$PKT" --dry-run --no-fetch --manifest "$MANIFEST" | sed 's/^/    /' | tail -n 3 || die "handoff-check failed; fix the packet before dispatch"
  check_gate before_dispatch
  NEWSTATUS=dispatched; SUMMARY="dispatch to $PACTOR as $(hdr_get "$PKT" role)${MODEL:+ ($MODEL)}"
elif [ -n "$SETSTATUS" ]; then
  EVENT=status-changed
  for c in "${WORK[@]}"; do [ "$c" = "$PKT" ] || die "status change commits only the packet; unexpected change: $c"; done
  case "$SETSTATUS" in
    accepted)
      [ "$STATUS" = landed ] || die "accepted requires status landed (is $STATUS)"
      # review linkage (§4): governed/protected work blocks acceptance until its independent review has landed
      if [ "$(hdr_get "$PKT" required_reviews)" = independent ]; then
        has_landed_review "$ID" || die "accepted blocked: required independent review for $ID has not landed (§4)"
        echo "review linkage ok: an independent review of $ID has landed"
      fi
      check_gate before_acceptance ;;
    returned) [ "$STATUS" = landed ] || die "returned requires status landed (is $STATUS)";;
    blocked) in_list "$STATUS" accepted superseded && die "cannot block a $STATUS handoff"; [ -n "$REASON" ] || die "--reason required for blocked";;
    superseded) ;; *) die "--set-status must be accepted|returned|blocked|superseded";;
  esac
  NEWSTATUS=$SETSTATUS; SUMMARY="status $STATUS → $SETSTATUS${REASON:+: $REASON}"
else
  [ ${#WORK[@]} -gt 0 ] || die "nothing to publish (no changes outside generated files)"
  for c in "${WORK[@]}"; do in_list "$c" "${OUTPUTS[@]}" && LANDED+=("$c"); done
  if [ ${#LANDED[@]} -gt 0 ]; then
    EVENT=output-landed; [ "$STATUS" = dispatched ] || die "output landing requires status dispatched (is $STATUS)"
    [ ${#DELETED[@]} -eq 0 ] || die "output landing cannot delete files: ${DELETED[*]}"
    for o in "${OUTPUTS[@]}"; do [ -e "$o" ] || die "unmet deliverable: declared output missing: $o"; done
    for c in "${WORK[@]}"; do
      in_list "$c" "${OUTPUTS[@]}" && continue; [ "$c" = "$PKT" ] && continue
      case "$c" in *.airlock.txt) continue;; esac
      die "file outside the handoff's declared outputs: $c (declare it in outputs, or it does not belong to $ID)"; done
    echo "handoff-check before landing (includes freeze check):"; scripts/handoff-check "$PKT" --dry-run --no-fetch --manifest "$MANIFEST" | sed 's/^/    /' | tail -n 3 || die "handoff-check failed (packet altered after dispatch, or inputs no longer on $SOT_BRANCH); nothing landed"
    # protected work that touches external systems takes its before-action approval at the landing (§8)
    [ "$PTIER" = protected ] && check_gate before_external_action
    NEWSTATUS=landed; SUMMARY="land ${#OUTPUTS[@]} output(s)"
  elif [ ${#WORK[@]} -eq 1 ] && [ "${WORK[0]}" = "$PKT" ]; then
    if on_sot "$PKT"; then EVENT=status-changed; SUMMARY="header/amendment update (status $STATUS)"
    else EVENT=handoff-created; in_list "$STATUS" draft ready || die "a new packet must be draft or ready"; SUMMARY="create handoff ($STATUS)"; fi
  else die "cannot classify: changes are neither declared outputs of $ID nor only the packet: ${WORK[*]}"; fi
fi
[ -n "$MSG" ] && SUMMARY=$MSG
echo "event: $EVENT${NEWSTATUS:+  (status $STATUS → $NEWSTATUS)}"

# --- human-review gate (§6): protected-path diffs are never auto-merged
NEEDS_REVIEW=""
if in_list "$EVENT" governance recovery; then
  # outputs of landed/accepted handoffs are accepted deliverables: replacing or deleting one needs review
  declare -a ACCEPTED_OUT=()
  for pk in $(ls "$PROJECTS_ROOT"/*/handoff/[0-9][0-9][0-9]-*.md 2>/dev/null); do
    hdr_present "$pk" || continue; in_list "$(hdr_get "$pk" status)" landed accepted || continue
    while IFS= read -r o; do [ -n "$o" ] && ACCEPTED_OUT+=("$o"); done < <(hdr_list "$pk" outputs); done
  for c in "${WORK[@]}"; do
    is_protected_path "$c" && NEEDS_REVIEW="$NEEDS_REVIEW $c(protected-path)"
    if in_list "$c" "${DELETED[@]}" && [[ "$c" == "$PROJECTS_ROOT"/* ]]; then NEEDS_REVIEW="$NEEDS_REVIEW $c(deletion)"; fi
    if in_list "$c" "${ACCEPTED_OUT[@]}" && on_sot "$c"; then NEEDS_REVIEW="$NEEDS_REVIEW $c(accepted-output)"; fi
  done
fi

# --- delivery provenance + mechanical verification against the raw return (airlock/branch)
INTTYPE=direct-write
if [ -n "$GENBY" ] && [ "$GENBY" != "$ACTOR" ]; then
  INTTYPE=airlock; in_list "$GENBY" $ACTORS || die "--generated-by '$GENBY' not an actor"
  [ -n "$SOURCE" ] || die "--source required for airlock/branch landings"
  in_list "$CMOD" none formatting-only substantive || die "--content-modified must be none|formatting-only|substantive"
  [ "$CMOD" = substantive ] && [ -z "$REASON" ] && die "--content-modified substantive requires --reason (a normal landing is none or formatting-only)"
  raw_for() { local o=$1 raw="$1.airlock.txt"
    if grep -q "^=== FILE: $o ===" "$raw" 2>/dev/null; then awk -v p="$o" '$0=="=== FILE: "p" ==="{f=1;next} f&&$0=="=== END FILE ==="{exit} f' "$raw"; else cat "$raw"; fi; }
  for o in "${LANDED[@]}"; do
    raw="$o.airlock.txt"
    grep -qI . "$o" 2>/dev/null || { [ "$CMOD" = none ] || die "binary output $o: only --content-modified none is allowed (fetched bytes are the raw return)"; continue; }
    case $CMOD in
      none) if [ -f "$raw" ]; then [ "$(raw_for "$o" | sha256)" = "$(sha256 < "$o")" ] || die "content-modified=none but $o differs from its raw return $raw"; fi;;
      formatting-only) [ -f "$raw" ] || die "content-modified=formatting-only requires the raw return at $raw for each landed output"
        [ "$(raw_for "$o" | tr -d '[:space:]' | sha256)" = "$(tr -d '[:space:]' < "$o" | sha256)" ] || die "$o differs from $raw beyond whitespace: that is substantive, not formatting-only";;
      substantive) [ -f "$raw" ] || die "content-modified=substantive requires the raw return at $raw for each landed output";;
    esac
  done
  echo "landing: generated-by=$GENBY source='$SOURCE' content-modified=$CMOD (verified against raw returns)"
fi

# --- size policy
total=0; big=""
for c in "${WORK[@]}"; do [ -f "$c" ] || continue; sz=$(fsize "$c"); total=$((total+sz))
  case "$(lower "$c")" in *.png|*.jpg|*.jpeg|*.gif|*.webp) lim=$LIMIT_IMAGE;; *) lim=$LIMIT_FILE;; esac
  [ $sz -gt $lim ] && big="$big $c($((sz/1024))KB)"; done
[ $total -gt $LIMIT_COMMIT ] && big="$big TOTAL($((total/1024))KB)"
if [ -n "$big" ]; then
  if [ $ALLOWLARGE = 1 ] && [ -n "$REASON" ]; then warn "size limits exceeded, allowed by --allow-large: $big"
  else die "size limits exceeded (§9):$big  — compress, drop variants, or --allow-large --reason '…'"; fi
fi

# --- landing policy (§5): derived from the diff, never chosen by an agent
INTEG=direct
if [ $EVENT = output-landed ]; then
  [ ${#WORK[@]} -le 2 ] || INTEG=branch                       # output + packet at most for a direct commit
  for c in "${LANDED[@]}"; do
    grep -qI . "$c" 2>/dev/null || INTEG=branch                # binary -> branch
    case "$c" in "$PROJECTS_ROOT/$SLUG/"*) ;; *) INTEG=branch;; esac
  done
  [ ${#LANDED[@]} -le 1 ] || INTEG=branch
fi
[ -n "$NEEDS_REVIEW" ] && INTEG=review
BR="$SLUG/$NNN-$FROLE"; [ $INTEG = review ] && BR="review/$EVENT-$(date -u +%Y%m%d-%H%M%S)"
case $INTEG in
  direct) echo "landing: direct";;
  branch) echo "landing: branch (branch $BR, auto-merged --no-ff)";;
  review) echo "landing: HUMAN-REVIEW PR required (§6) — touches:$NEEDS_REVIEW"; echo "         will commit to branch $BR and push it; NOT merged by this script";;
esac

if [ $DRY = 1 ]; then echo "---"; echo "DRY-RUN: no files changed, nothing committed. Would produce event=$EVENT landing=$INTEG${NEWSTATUS:+ status→$NEWSTATUS}."; exit 0; fi

# --- apply header transitions
if [ -n "$NEWSTATUS" ]; then
  hdr_set "$PKT" status "$NEWSTATUS"
  if [ $DISPATCH = 1 ]; then
    [ -n "$MODEL" ] && hdr_set "$PKT" model "$MODEL"
    hdr_set "$PKT" manifest_sha "$(sot_sha)"
    hdr_set "$PKT" manifest_hash "$(manifest_hash)"
    hdr_set "$PKT" instructions_hash "$(instructions_hash "$PKT")"
    hdr_set "$PKT" frozen_hash "$(frozen_hash "$PKT")"     # frozen_hash last: it covers the fields above it
  fi
  [ "$NEWSTATUS" = blocked ] && { printf '\n## Blocked\n%s — %s: %s\n' "$(date -u +%F)" "$ACTOR" "$REASON" >> "$PKT"; }
fi

# --- trailers
trailers() { printf 'Workflow-Event: %s\nHandoff: %s\nActor: %s\nProject: %s\nCore-Version: %s\n' "$1" "${ID:-none}" "$ACTOR" "$PROJECT" "$POLICY_VERSION"
  if [ $INTTYPE = airlock ]; then printf 'Generated-By: %s\nIntegrated-By: %s\nIntegration-Type: airlock\nSource-Artifact: %s\nContent-Modified: %s\n' "$GENBY" "$ACTOR" "$SOURCE" "$CMOD"; [ "$CMOD" = substantive ] && printf 'Modification-Reason: %s\n' "$REASON"; fi
  [ $ALLOWLARGE = 1 ] && printf 'Large-Files-Allowed: %s\n' "$REASON"; return 0; }
declare -a TO_ADD=(); for c in "${WORK[@]}"; do TO_ADD+=("$c"); done; [ -n "$PKT" ] && TO_ADD+=("$PKT")
[ ${#TO_ADD[@]} -gt 0 ] || TO_ADD=("${GEN_FILES[@]}")
COMMIT_MSG="$(printf '%s: %s — %s\n\n%s' "$EVENT" "${ID:-kit}" "$SUMMARY" "$(trailers "$EVENT")")"

# --- human-review path: commit on a branch, push it, stop. The Owner merges the PR; the merge is exempt from drift.
if [ $INTEG = review ]; then
  git checkout -q -b "$BR"; git add -A -- "${TO_ADD[@]}"; git commit -q -m "$COMMIT_MSG"
  git push -q -u origin "$BR" || die "could not push $BR"
  git checkout -q "$SOT_BRANCH"
  echo "---"; echo "HUMAN REVIEW REQUIRED — nothing merged."
  echo "branch pushed: $BR @ $(git rev-parse --short=7 "$BR")"
  echo "next: open a PR from $BR to $SOT_BRANCH for $OWNER; after merge, run: scripts/publish --regen && scripts/publish --event $EVENT --actor $ACTOR --message \"records for merged PR: $SUMMARY\""
  echo "Available to other agents: no (awaiting human review)"; exit 0
fi

# --- commit A (work)
if [ $INTEG = branch ]; then
  git checkout -q -b "$BR"; git add -A -- "${TO_ADD[@]}"; git commit -q -m "$COMMIT_MSG"
  git checkout -q "$SOT_BRANCH"; git merge -q --no-ff -m "$(printf 'merge %s — %s\n\n%s' "$BR" "$SUMMARY" "$(trailers "$EVENT")")" "$BR"; git branch -q -d "$BR"
else
  git add -A -- "${TO_ADD[@]}"; git commit -q -m "$COMMIT_MSG"
fi
SHA_A=$(git rev-parse --short=7 HEAD)

# --- commit B (records): regenerate state, index, log against HEAD (what the branch will contain after push)
STATE_REF=HEAD; regen_all; STATE_REF="origin/$SOT_BRANCH"
case $EVENT in
  output-landed) log_append "$EVENT" "$ID" "$ACTOR" "$SHA_A" "$(printf '%s; ' "${OUTPUTS[@]}" | sed 's/; $//')" "dispatched → landed" "$(next_action_for landed "$ACTOR" "$FROLE")";;
  governance|recovery) log_append "$EVENT" "${ID:-}" "$ACTOR" "$SHA_A" "$(printf '%s; ' "${WORK[@]:0:8}" | sed 's/; $//')$( [ ${#WORK[@]} -gt 8 ] && echo " … (${#WORK[@]} files)")" "" "";;
esac
git add -A -- "${GEN_FILES[@]}" 2>/dev/null || true
if ! git diff --cached --quiet; then
  git commit -q -m "$(printf 'records: %s @ %s\n\nWorkflow-Event: records\nRecords-For: %s\nHandoff: %s\nActor: %s\nProject: %s\nCore-Version: %s\n' "${ID:-kit}" "$SHA_A" "$SHA_A" "${ID:-none}" "$ACTOR" "$PROJECT" "$POLICY_VERSION")"
fi

# --- push (with rescue on rejection) + verify
if ! git push -q origin "$SOT_BRANCH" 2>/dev/null; then
  RESCUE="rescue/${ID//\//-}-$(date -u +%Y%m%d-%H%M%S)"; [ -n "$ID" ] || RESCUE="rescue/$EVENT-$(date -u +%Y%m%d-%H%M%S)"
  git branch -q "$RESCUE" HEAD; git fetch -q origin "$SOT_BRANCH"; git reset -q --hard "origin/$SOT_BRANCH"
  die "push to $SOT_BRANCH rejected (remote advanced or no permission). Your unpublished commits are preserved on local branch $RESCUE; local $SOT_BRANCH has been realigned. Do NOT force-push. Recover with: git checkout $RESCUE -- ${TO_ADD[*]} ; then re-run this publish command."
fi
git fetch -q origin "$SOT_BRANCH"
AVAIL=yes; echo "---"; echo "DELIVERY RECEIPT"
echo "repository:   $(git remote get-url origin)"; echo "handoff:      ${ID:-none}"; echo "event:        $EVENT"; echo "landing:      $INTEG"
echo "$SOT_BRANCH sha:  $(sot_sha)  (work commit $SHA_A)"
for o in "${OUTPUTS[@]}"; do
  if on_sot "$o"; then
    if [ $EVENT = output-landed ] || in_list "${NEWSTATUS:-$STATUS}" landed accepted superseded returned; then echo "verified:     $o @ $(git log -1 --format=%h "origin/$SOT_BRANCH" -- "$o")"
    else echo "to overwrite: $o (current @ $(git log -1 --format=%h "origin/$SOT_BRANCH" -- "$o"); a new SHA here means landed)"; fi
  elif [ $EVENT = output-landed ]; then echo "MISSING:      $o"; AVAIL=no
  else echo "pending:      $o (not yet produced)"; fi; done
[ $INTEG = branch ] && echo "branch:       $BR merged --no-ff and deleted" || echo "branch:       none (direct to $SOT_BRANCH)"
echo "validation:   passed${big:+ (size override: $REASON)}"
[ -n "$NEWSTATUS" ] && echo "status:       $STATUS → $NEWSTATUS"
[ $EVENT = output-landed ] || AVAIL="n/a (no outputs in this event)"
echo "Available to other agents: $AVAIL"
[ "$AVAIL" = no ] && exit 1 || exit 0
